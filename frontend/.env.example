# ScanWise Frontend Environment Variables
VITE_API_BASE_URL=/api

# true  = run fully on built-in mock data (no backend needed). Use this until the Flask backend is running.
# false = call the real backend through the Vite proxy (http://127.0.0.1:5000).
VITE_USE_MOCKS=true

# Optional (dev only): when VITE_USE_MOCKS=false, fall back to mocks if the backend is unreachable.
# VITE_ALLOW_MOCK_FALLBACK=true